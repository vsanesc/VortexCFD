@@ -0,0 +1,105 @@
+"""Freestream far field (D-065): the mass balance with far-field fluxes (real output, fixture
+tests/data/freestream_run/) and, marker ``long``, slip against freestream on the flattened ellipsoid
+at alpha = 10 deg (same mesh, same criteria):
+
+    .venv/bin/pytest -m long -s tests/test_far_field.py
+"""
+
+import json
+import shutil
+from pathlib import Path
+
+import pytest
+
+from tests.real_cases import flattened_ellipsoid, mesh_body, run_solver, write_solver_case
+from vortexcfd.core.model import AsymptoticCriterion, Inflow, Solvers, StoppingCriteria
+from vortexcfd.foam.dictfile import read_foam_file, write_foam_file
+from vortexcfd.foam.physics_case import FAR_FIELD
+from vortexcfd.foam.postprocessing import ReportMonitor
+
+DATA = Path(__file__).parent / "data" / "freestream_run"
+FIELDS = ("U", "p", "k", "omega")
+
+
+def test_mass_balance_sums_the_far_field_fluxes(tmp_path: Path) -> None:
+    """Real freestream run (alpha 10 deg): the far field carries flux (in through the bottom, out
+    through the top); the imbalance is 100 (inlet + outlet + far field) / |inlet|."""
+    case = tmp_path / "case"
+    for patch in ("inlet", "outlet", *FAR_FIELD):
+        target = case / "postProcessing" / f"massFlow_{patch}" / "0"
+        target.mkdir(parents=True)
+        shutil.copy(DATA / f"massFlow_{patch}.dat", target / "surfaceFieldValue.dat")
+    monitor = ReportMonitor(case)
+    monitor.poll()
+    inlet, outlet, pct, far = monitor.mass_balance()
+    last = {patch: float((DATA / f"massFlow_{patch}.dat").read_text().split()[-1]) for patch in ("top", "bottom")}
+    assert last["top"] > 0.2 * abs(inlet) and last["bottom"] < -0.2 * abs(inlet)  # flow crosses the far field
+    assert far == pytest.approx(sum(float((DATA / f"massFlow_{p}.dat").read_text().split()[-1]) for p in FAR_FIELD))
+    assert pct == pytest.approx(100 * (inlet + outlet + far) / abs(inlet))
+    summary = json.loads((DATA / "summary.json").read_text())
+    assert pct == pytest.approx(summary["freestream"]["mass_imbalance_percent"], abs=1e-9)
+    assert abs(pct) < 0.1
+    assert len(monitor.series("mass_imbalance")) == summary["freestream"]["iterations"]
+
+
+def _slip_far_field(case: Path) -> None:
+    """The D-022 far field: slip on sides/top/bottom for U, p, k and omega (nut stays calculated)."""
+    for field in FIELDS:
+        data = read_foam_file(case / "0" / field)
+        for patch in FAR_FIELD:
+            data["boundaryField"][patch] = {"type": "slip"}
+        cls = "volVectorField" if field == "U" else "volScalarField"
+        write_foam_file(case / "0" / field, {k: data[k] for k in ("dimensions", "internalField", "boundaryField")},
+                        object_name=field, class_name=cls)
+
+
+@pytest.mark.long
+@pytest.mark.slow
+def test_slip_against_freestream_far_field_at_ten_degrees(tmp_path: Path) -> None:
+    """The flattened ellipsoid (semi-axes 0.5 x 0.5 x 0.15 m, default mesh) at 20 m/s and alpha
+    10 deg, 4 cores, Cd and Cl asymptotic (window 50, tolerance 1 %), at most 600 iterations: Cl,
+    Cd and the mass imbalance with the slip far field (D-022) and the freestream far field (D-065).
+    Writes tests/data/freestream_run/ (summary and the freestream run's mass-flow files)."""
+    meshed = mesh_body(tmp_path / "mesh", flattened_ellipsoid(), "Body")
+    assert meshed.ok, "".join(meshed.lines[-30:])
+    stopping = StoppingCriteria(criteria=[AsymptoticCriterion(quantity="Cd", window=50, tolerance=0.01),
+                                          AsymptoticCriterion(quantity="Cl", window=50, tolerance=0.01)])
+    out = {"cells": meshed.cells}
+    for variant in ("slip", "freestream"):
+        case = tmp_path / variant
+        shutil.copytree(meshed.case_dir, case)
+        copy = type(meshed)(case, meshed.inputs)
+        write_solver_case(copy, inflow=Inflow(alpha_deg=10.0),
+                          solvers=Solvers(iterations=600, write_interval=600, cores=4, stopping=stopping))
+        if variant == "slip":
+            _slip_far_field(case)
+        result = run_solver(case, timeout_s=1800, stopping=stopping, cores=4)
+        assert result is not None and result.state in ("criteria_met", "iteration_limit"), result
+        monitor = ReportMonitor(case)
+        monitor.poll()
+        inlet, outlet, pct, far = monitor.mass_balance()
+        window = {}
+        for q in ("Cl", "Cd"):  # the last 50 iterations: the freestream run oscillates
+            values = [v for _, v in monitor.series(q)][-50:]
+            mean = sum(values) / len(values)
+            window[q] = {"mean": mean, "min": min(values), "max": max(values),
+                         "range_percent": 100 * (max(values) - min(values)) / max(abs(mean), 0.01)}
+        out[variant] = {"Cl": monitor.series("Cl")[-1][1], "Cd": monitor.series("Cd")[-1][1], "last_50": window,
+                        "mass_imbalance_percent": pct, "far_field_flux": far, "inlet_flux": inlet,
+                        "outlet_flux": outlet, "iterations": result.iterations, "state": result.state}
+        if variant == "freestream":
+            DATA.mkdir(parents=True, exist_ok=True)
+            for patch in ("inlet", "outlet", *FAR_FIELD):
+                src = next((case / "postProcessing" / f"massFlow_{patch}").glob("*/surfaceFieldValue.dat"))
+                shutil.copy(src, DATA / f"massFlow_{patch}.dat")
+    (DATA / "summary.json").write_text(json.dumps(out, indent=2) + "\n")
+    print(f"\n{meshed.cells} cells")
+    print("| Far field | Cl (last) | Cd (last) | Cl last 50: mean, range | Cd last 50: mean, range | Mass imbalance "
+          "| Iterations | End |")
+    print("|---|---|---|---|---|---|---|---|")
+    for v in ("slip", "freestream"):
+        r, w = out[v], out[v]["last_50"]
+        imb = "n/a" if r["mass_imbalance_percent"] is None else f"{r['mass_imbalance_percent']:.3g} %"
+        print(f"| {v} | {r['Cl']:.5g} | {r['Cd']:.5g} | {w['Cl']['mean']:.5g}, {w['Cl']['range_percent']:.3g} % | "
+              f"{w['Cd']['mean']:.5g}, {w['Cd']['range_percent']:.3g} % | {imb} | {r['iterations']} | {r['state']} |")
+    assert out["freestream"]["far_field_flux"] is not None and out["slip"]["far_field_flux"] is not None
