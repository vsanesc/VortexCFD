# Virtual environments
.venv/
venv/
ENV/

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Pytest
.pytest_cache/

# OpenFOAM runtime artifacts / temporary logs
log.*
# ...except the real logs kept as test fixtures (docs/QUESTIONS.md item 68)
!tests/data/**/log.*
cavity/
run/
*:Zone.Identifier

# Meshing benchmark (D-081, D-082): generated geometries and result files; benchmarks/baseline.json is kept
benchmarks/geometries/*.stl
benchmarks/geometries/*.step
benchmarks/results/
# Local-only benchmark cases (D-094): the owner's geometry is never committed
benchmarks/local_cases.json
